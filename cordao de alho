.pr{background:var(--card);border:1px solid var(--bd);border-radius:18px;overflow:hidden;display:flex;flex-direction:column}
.pr img,.ph{width:100%;height:170px;object-fit:cover;background:var(--pp);display:flex;align-items:center;justify-content:center;font-size:56px}
.pr .bd{padding:14px 16px 16px;display:flex;flex-direction:column;gap:8px;flex:1}
.pr h3{margin:0;font-size:18px}.pr p{margin:0;font-size:14px}
.tag{align-self:flex-start;background:var(--p);color:var(--bt);font-size:12px;font-weight:800;padding:3px 10px;border-radius:99px}
.price{font-weight:800;font-size:20px;color:var(--p)}
select,input,textarea{width:100%;font:inherit;font-size:16px;color:var(--tx);background:var(--bg);border:1.5px solid var(--bd);border-radius:10px;padding:10px 12px}
input[type=checkbox]{width:auto}
textarea{min-height:70px;resize:vertical}
:focus-visible{outline:3px solid var(--pl);outline-offset:1px}
.box{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:18px;margin-top:16px}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--bd)}
.row:last-child{border:0}
.q{display:flex;align-items:center;gap:8px}
.q button{width:34px;height:34px;border-radius:10px;border:1.5px solid var(--bd);background:var(--bg);color:var(--tx);font-weight:800;cursor:pointer}
.tot{display:flex;justify-content:space-between;padding:4px 0}
.tot.g{font-weight:800;font-size:20px;color:var(--p);border-top:2px solid var(--bd);margin-top:6px;padding-top:10px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:640px){.cols{grid-template-columns:1fr}nav a{padding:8px 6px;font-size:13px}.logo{font-size:15px}}
label.f{display:block;margin-top:12px;font-weight:600;font-size:14px}
label.f span{display:block;margin-bottom:5px}
label.ck{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:14px;font-weight:600}
.msg{display:none;padding:12px 14px;border-radius:12px;font-weight:700;font-size:14px;margin-top:12px}
.msg.er{display:block;background:var(--erb);color:var(--er)}
.msg.ok{display:block;background:var(--okb);color:var(--ok)}
pre{white-space:pre-wrap;word-break:break-word;background:var(--bg);border:1px solid var(--bd);border-radius:12px;padding:12px;font:13px/1.5 ui-monospace,Menlo,monospace}
footer{background:var(--p);color:var(--bt);padding:30px 0 40px;text-align:center}
footer a{color:var(--bt)}
footer .btn.wa{margin:10px 0}
.own{background:none;border:0;color:var(--bt);text-decoration:underline;font:inherit;font-size:13px;cursor:pointer;opacity:.85;margin-top:14px}
.modal{display:none;position:fixed;inset:0;background:rgba(20,10,40,.65);align-items:center;justify-content:center;padding:16px;z-index:50;overflow:auto}
.modal.open{display:flex}
.mc{background:var(--card);border-radius:18px;padding:24px;width:100%;max-width:420px;border:1px solid var(--bd)}
#adm{display:none;position:fixed;inset:0;overflow:auto;background:var(--bg);z-index:60;padding:env(safe-area-inset-top,0px) 0 40px}
#adm.open{display:block}
#adm .top{position:sticky;top:0;background:var(--card);border-bottom:1px solid var(--bd);padding:12px 18px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;z-index:2}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--p);color:var(--bt);padding:11px 18px;border-radius:99px;font-weight:700;font-size:14px;display:none;z-index:70}
.thumb{width:80px;height:60px;object-fit:cover;border-radius:8px;margin-top:6px;display:block}
</style>
</head>
