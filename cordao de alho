<script type="application/json" id="dados">{"aviso":"Cardápio atualizado!","taxa":0,"pagamentos":["Pix","Dinheiro","Cartão de débito","Cartão de crédito"],"pix":"","pratos":[{"id":"p1","nome":"Frango grelhado (exemplo)","desc":"Peito de frango grelhado com temperos naturais e alho.","acomp":"Arroz, feijão e salada","foto":"","tam":[{"n":"Média","p":20},{"n":"Grande","p":25}],"disp":true,"dia":true},{"id":"p2","nome":"Carne de panela (exemplo)","desc":"Carne macia cozida lentamente com legumes.","acomp":"Arroz, feijão e purê","foto":"","tam":[{"n":"Média","p":22},{"n":"Grande","p":28}],"disp":true,"dia":true}]}</script>
<script>
(function(){
var $=function(i){return document.getElementById(i)};
var D,W,AR=null,AS=null,cart=[],WA="5567991702762",EM=["usuario90@gmail","usuario90@gmail.com"],PW="isadora2020";
try{D=JSON.parse($("dados").textContent)}catch(e){D={aviso:"",taxa:0,pagamentos:["Pix","Dinheiro"],pix:"",pratos:[]}}
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function brl(v){return "R$ "+Number(v).toFixed(2).replace(".",",")}
function num(s){var n=parseFloat(String(s).replace(",","."));return isNaN(n)||n<0?0:n}
function toast(t){var e=$("toast");e.textContent=t;e.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(function(){e.style.display="none"},2200)}
function msg(id,t,k){var e=$(id);e.textContent=t;e.className="msg "+(t?k:"")}

/* ---------- Cardápio ---------- */
function renderMenu(){
  var a=$("aviso");a.textContent=D.aviso||"";a.style.display=D.aviso?"block":"none";
  var ps=D.pratos.slice().sort(function(x,y){return (y.dia?1:0)-(x.dia?1:0)});
  $("lista").innerHTML=ps.length?ps.map(card).join(""):'<p class="mu">O cardápio será atualizado em breve.</p>';
}
function card(p){
  var foto=p.foto?'<img src="'+esc(p.foto)+'" alt="'+esc(p.nome)+'" loading="lazy">':'<div class="ph" aria-hidden="true">🍛</div>';
  var t=p.tam,sel=t.length>1?'<select id="t_'+p.id+'" aria-label="Tamanho da marmita">'+t.map(function(x,i){return '<option value="'+i+'">'+esc(x.n)+" — "+brl(x.p)+"</option>"}).join("")+"</select>":'<input type="hidden" id="t_'+p.id+'" value="0">';
  var pr=t.length>1?"a partir de "+brl(Math.min.apply(null,t.map(function(x){return x.p}))):brl(t[0].p);
  return '<article class="pr">'+foto+'<div class="bd">'+(p.dia?'<span class="tag">Prato do dia</span>':"")+"<h3>"+esc(p.nome)+"</h3><p>"+esc(p.desc)+"</p>"+(p.acomp?'<p class="mu"><b>Acompanhamentos:</b> '+esc(p.acomp)+"</p>":"")+'<div class="price">'+pr+"</div>"+sel+(p.disp?'<button class="btn" data-add="'+p.id+'">ADICIONAR AO PEDIDO</button>':'<button class="btn" disabled>ESGOTADO</button>')+"</div></article>";
}
$("lista").addEventListener("click",function(e){
  var id=e.target.getAttribute("data-add");if(!id)return;
  var p=D.pratos.filter(function(x){return x.id===id})[0];if(!p||!p.disp)return;
  var i=parseInt($("t_"+id).value,10)||0,t=p.tam[i],k=id+"|"+i;
  var it=cart.filter(function(c){return c.k===k})[0];
  if(it)it.q++;else cart.push({k:k,nome:p.nome,tam:p.tam.length>1?t.n:"",p:t.p,q:1});
  renderCart();toast("Adicionado ao pedido!");
});

/* ---------- Carrinho ---------- */
function tot(){
  var s=cart.reduce(function(a,c){return a+c.p*c.q},0),ent=$("tipo").value==="Entrega";
  var tx=ent&&cart.length?num(D.taxa):0;return{s:s,tx:tx,t:s+tx,ent:ent};
}
function renderCart(){
  var n=cart.reduce(function(a,c){return a+c.q},0);$("cnt").textContent=n;
  if(!cart.length){$("cart").innerHTML='<p class="mu" style="margin:0">Seu pedido está vazio. Escolha uma marmita no cardápio.</p>';return}
  var T=tot();
  $("cart").innerHTML=cart.map(function(c){return '<div class="row"><div><b>'+esc(c.nome)+"</b>"+(c.tam?' <span class="mu">('+esc(c.tam)+")</span>":"")+'<br><span class="mu">'+brl(c.p)+' cada</span></div><div class="q"><button data-m="'+c.k+'" aria-label="Diminuir">−</button><b>'+c.q+'</b><button data-pl="'+c.k+'" aria-label="Aumentar">+</button><button data-r="'+c.k+'" aria-label="Remover" title="Remover">✕</button></div></div>'}).join("")
   +'<div class="tot"><span>Subtotal</span><span>'+brl(T.s)+"</span></div>"+(T.ent&&num(D.taxa)>0?'<div class="tot"><span>Taxa de entrega</span><span>'+brl(T.tx)+"</span></div>":"")+'<div class="tot g"><span>Total</span><span>'+brl(T.t)+"</span></div>";
}
$("cart").addEventListener("click",function(e){
  var b=e.target,k=b.getAttribute("data-m")||b.getAttribute("data-pl")||b.getAttribute("data-r");if(!k)return;
  var it=cart.filter(function(c){return c.k===k})[0];if(!it)return;
  if(b.hasAttribute("data-pl"))it.q++;
  else if(b.hasAttribute("data-m")){it.q--;if(it.q<1)cart=cart.filter(function(c){return c!==it})}
  else cart=cart.filter(function(c){return c!==it});
  renderCart();
});

/* ---------- Checkout ---------- */
function fillPag(){
  var s=$("pag"),cur=s.value;
  s.innerHTML='<option value="">Selecione…</option>'+D.pagamentos.map(function(p){return "<option>"+esc(p)+"</option>"}).join("");
  if(D.pagamentos.indexOf(cur)>-1)s.value=cur;pagChange();
}
function pagChange(){
  var v=$("pag").value,din=/dinheiro/i.test(v),pix=/pix/i.test(v)&&D.pix;
  $("troco").style.display=din?"block":"none";
  $("vtw").style.display=din&&$("ptroco").value==="sim"?"block":"none";
  var pi=$("pixinfo");pi.textContent=pix?"Chave Pix: "+D.pix:"";pi.className="msg"+(pix?" ok":"");
}
$("pag").addEventListener("change",pagChange);
$("ptroco").addEventListener("change",pagChange);
$("tipo").addEventListener("change",function(){$("end").style.display=$("tipo").value==="Entrega"?"block":"none";renderCart()});
$("f").addEventListener("submit",function(e){
  e.preventDefault();
  var er=[],T=tot(),g=function(i){return $(i).value.trim()};
  if(!cart.length)er.push("Adicione ao menos uma marmita ao pedido.");
  if(g("nome").length<3)er.push("Informe seu nome completo.");
  if(g("tel").replace(/\D/g,"").length<10)er.push("Informe um telefone com DDD.");
  if(T.ent){if(!g("rua"))er.push("Informe a rua e o número.");if(!g("bairro"))er.push("Informe o bairro.");if(!g("cidade"))er.push("Informe a cidade.")}
  if(!$("pag").value)er.push("Escolha a forma de pagamento.");
  var troco="";
  if(/dinheiro/i.test($("pag").value)&&$("ptroco").value==="sim"){var vt=num($("vt").value);if(vt<=T.t)er.push("O valor do troco deve ser maior que o total ("+brl(T.t)+").");else troco=brl(vt)}
  if(er.length){msg("err",er.join(" "),"er");return}
  msg("err","","");
  var L=["NOVO PEDIDO — MARMITARIA CORDÃO DE ALHO","","Nome: "+g("nome"),"","Telefone: "+g("tel"),"","Tipo: "+$("tipo").value,"","ENDEREÇO DE ENTREGA:",
    T.ent?g("rua")+", "+g("bairro")+", "+g("cidade")+(g("comp")?" — "+g("comp"):""):"Retirada (sem entrega)","","PEDIDO:"];
  cart.forEach(function(c){L.push(c.q+" x "+c.nome+(c.tam?" ("+c.tam+")":"")+" — "+brl(c.p*c.q))});
  L.push("","Observações: "+(g("obs")||"Nenhuma"),"","Subtotal: "+brl(T.s),"","Taxa de entrega: "+brl(T.tx),"","TOTAL: "+brl(T.t),"","Forma de pagamento: "+$("pag").value);
  if(troco)L.push("","Troco para: "+troco);
  var txt=L.join("\n"),url="https://wa.me/"+WA+"?text="+encodeURIComponent(txt);
  var c=$("conf");c.style.display="block";
  c.innerHTML='<h3 style="margin:0 0 6px">Pedido pronto para enviar</h3><p class="mu" style="margin:0 0 10px">Confira a mensagem abaixo. O pedido <b>só é enviado quando você tocar em "enviar" dentro do WhatsApp</b>.</p><pre>'+esc(txt)+'</pre><a class="btn wa" style="width:100%;margin-top:12px" target="_blank" rel="noopener" href="'+url+'">ABRIR WHATSAPP E ENVIAR</a>';
  c.scrollIntoView({behavior:"smooth",block:"start"});
  try{window.open(url,"_blank","noopener")}catch(x){}
});

/* ---------- Acesso do proprietário ---------- */
function open_(id,on){$(id).classList[on?"add":"remove"]("open");document.body.classList[on?"add":"remove"]("lock")}
$("ownerlnk").addEventListener("click",function(){msg("lerr","","");$("lf").reset();open_("mlogin",true);$("lemail").focus()});
$("lcancel").addEventListener("click",function(){open_("mlogin",false)});
$("lf").addEventListener("submit",function(e){
  e.preventDefault();
  var em=$("lemail").value.trim().toLowerCase(),pw=$("lsenha").value;
  if(!em||!pw){msg("lerr","Preencha o e-mail e a senha.","er");return}
  if(EM.indexOf(em)>-1&&pw===PW){try{sessionStorage.setItem("adm","1")}catch(x){}open_("mlogin",false);abrirAdmin()}
  else{msg("lerr","E-mail ou senha incorretos. Tente novamente.","er");$("lsenha").value="";$("lsenha").focus()}
});

function makeW(){
  W={aviso:D.aviso||"",taxa:String(D.taxa||0).replace(".",","),pagamentos:D.pagamentos.join(", "),pix:D.pix||"",
   pratos:D.pratos.map(function(p){return{id:p.id,nome:p.nome,desc:p.desc||"",acomp:p.acomp||"",foto:p.foto||"",
    tamTxt:p.tam.map(function(t){return t.n+"="+String(t.p).replace(".",",")}).join("\n"),disp:!!p.disp,dia:!!p.dia}})};
}
function fld(l,i){return '<label class="f"><span>'+l+"</span>"+i+"</label>"}
function renderAdmin(){
  var h='<div class="box"><h3 style="margin:0">Aviso do dia, entrega e pagamento</h3>'
   +fld("Aviso do dia (ex.: Cardápio atualizado!, Últimas unidades!)",'<input data-c="aviso" value="'+esc(W.aviso)+'">')
   +fld("Taxa de entrega (R$) — use 0 se não houver",'<input data-c="taxa" inputmode="decimal" value="'+esc(W.taxa)+'">')
   +fld("Formas de pagamento aceitas (separe por vírgula)",'<input data-c="pagamentos" value="'+esc(W.pagamentos)+'">')
   +fld("Chave Pix (opcional — só aparece para o cliente se preenchida)",'<input data-c="pix" value="'+esc(W.pix)+'">')+"</div>"
   +'<h3 style="margin:22px 0 0">Pratos</h3>';
  W.pratos.forEach(function(p,i){
    var d='data-i="'+i+'" ';
    h+='<div class="box"><h4 style="margin:0;color:var(--p)">'+esc(p.nome||"Novo prato")+"</h4>"
     +fld("Nome",'<input '+d+'data-f="nome" value="'+esc(p.nome)+'">')
     +fld("Descrição",'<textarea '+d+'data-f="desc">'+esc(p.desc)+"</textarea>")
     +fld("Acompanhamentos",'<input '+d+'data-f="acomp" value="'+esc(p.acomp)+'">')
     +fld("Tamanhos e preços (um por linha, no formato Nome=preço — ex.: Média=20,00)",'<textarea '+d+'data-f="tamTxt">'+esc(p.tamTxt)+"</textarea>")
     +'<label class="f"><span>Foto</span>'+(p.foto?'<img class="thumb" src="'+esc(p.foto)+'" alt="">':"")+(AS?'<input type="file" accept="image/*" data-up="'+i+'">':'<span class="mu">Envio de fotos indisponível nesta visualização.</span>')+"</label>"
     +'<label class="ck"><input type="checkbox" '+d+'data-f="disp"'+(p.disp?" checked":"")+"> Disponível (desmarque para marcar como ESGOTADO)</label>"
     +'<label class="ck"><input type="checkbox" '+d+'data-f="dia"'+(p.dia?" checked":"")+"> Prato do dia (aparece em destaque)</label>"
     +'<button class="out" style="margin-top:14px" type="button" data-del="'+i+'">Excluir prato</button></div>';
  });
  $("admbody").innerHTML=h+'<button class="btn sec" style="margin-top:16px" type="button" id="novo">+ ADICIONAR PRATO</button>';
}
function abrirAdmin(){makeW();renderAdmin();msg("admmsg","","");open_("adm",true);$("adm").scrollTop=0}
$("admbody").addEventListener("input",function(e){
  var t=e.target,c=t.getAttribute("data-c"),i=t.getAttribute("data-i"),f=t.getAttribute("data-f");
  if(c)W[c]=t.value;else if(i!==null&&f)W.pratos[i][f]=t.type==="checkbox"?t.checked:t.value;
});
$("admbody").addEventListener("change",function(e){
  var t=e.target,u=t.getAttribute("data-up");
  if(u!==null&&t.files&&t.files[0]&&AS){
    msg("admmsg","Enviando foto…","ok");
    AS.upload(t.files[0]).then(function(r){W.pratos[u].foto="/_blob/"+r.id;renderAdmin();msg("admmsg","Foto enviada. Clique em Publicar alterações para salvar.","ok")})
     .catch(function(){msg("admmsg","Não foi possível enviar a foto.","er")});
  }
});
$("admbody").addEventListener("click",function(e){
  var b=e.target;
  if(b.id==="novo"){W.pratos.push({id:"p"+Date.now(),nome:"",desc:"",acomp:"",foto:"",tamTxt:"",disp:true,dia:false});renderAdmin();return}
  var d=b.getAttribute("data-del");
  if(d!==null){
    if(b.getAttribute("data-sure")){W.pratos.splice(+d,1);renderAdmin()}
    else{b.setAttribute("data-sure","1");b.textContent="Clique de novo para confirmar a exclusão"}
  }
});
$("sair").addEventListener("click",function(){try{sessionStorage.removeItem("adm")}catch(x){}open_("adm",false)});

function limpar(){
  var pg=W.pagamentos.split(",").map(function(s){return s.trim()}).filter(Boolean);
  if(!pg.length)return{e:"Informe ao menos uma forma de pagamento."};
  var ps=[];
  for(var i=0;i<W.pratos.length;i++){
    var p=W.pratos[i],nome=p.nome.trim();
    if(!nome)return{e:"Dê um nome ao prato "+(i+1)+" ou exclua-o."};
    var tam=[];
    p.tamTxt.split("\n").forEach(function(l){var k=l.lastIndexOf("=");if(k<1)return;var n=l.slice(0,k).trim(),v=num(l.slice(k+1));if(n&&v>0)tam.push({n:n,p:v})});
    if(!tam.length)return{e:'Informe ao menos um tamanho com preço em "'+nome+'" (ex.: Média=20,00).'};
    ps.push({id:p.id,nome:nome,desc:p.desc.trim(),acomp:p.acomp.trim(),foto:p.foto,tam:tam,disp:!!p.disp,dia:!!p.dia});
  }
  return{d:{aviso:W.aviso.trim(),taxa:num(W.taxa),pagamentos:pg,pix:W.pix.trim(),pratos:ps}};
}
$("pub").addEventListener("click",function(){
  var r=limpar();if(r.e){msg("admmsg",r.e,"er");return}
  if(!AR){msg("admmsg","Não foi possível salvar aqui: abra o site logado no claude.ai como dono da página para publicar alterações.","er");return}
  var c=document.documentElement.cloneNode(true);
  c.querySelector("#dados").textContent=JSON.stringify(r.d).replace(/</g,"\\u003c");
  ["lista","cart","admbody","conf","aviso","toast"].forEach(function(id){var e=c.querySelector("#"+id);if(e){e.innerHTML="";e.removeAttribute("style")}});
  c.querySelector("#conf").setAttribute("style","display:none");
  [].forEach.call(c.querySelectorAll(".open"),function(e){e.classList.remove("open")});
  c.querySelector("body").classList.remove("lock");
  msg("admmsg","Publicando…","ok");$("pub").disabled=true;
  AR.publish("<!DOCTYPE html>\n"+c.outerHTML).then(function(){msg("admmsg","Publicado! A página será recarregada com o novo cardápio.","ok")})
   .catch(function(err){$("pub").disabled=false;msg("admmsg",(err&&err.code==="conflict")?"Outra alteração foi publicada ao mesmo tempo. A página será recarregada.":"Não foi possível publicar. Verifique se você é o dono da página no claude.ai.","er")});
});

/* ---------- Início ---------- */
renderMenu();fillPag();renderCart();
if(window.claude&&claude.use){
  claude.use("artifact").then(function(a){AR=a}).catch(function(){});
  claude.use("assets").then(function(a){AS=a;if($("adm").classList.contains("open")){var s=$("adm").scrollTop;renderAdmin();$("adm").scrollTop=s}}).catch(function(){});
}
try{if(sessionStorage.getItem("adm")==="1")abrirAdmin()}catch(x){}
})();
</script>


