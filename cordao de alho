<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f6f1fd;--card:#fff;--tx:#2a1648;--mu:#6b5a86;--p:#4a1d8a;--pl:#8e5fd6;--pp:#e9ddfa;--bd:#d9c9f0;--er:#9b1c3a;--erb:#fde8ec;--ok:#1e6b3a;--okb:#e7f6ec;--bt:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1a1226;--card:#261b38;--tx:#f1eaff;--mu:#b9a6d9;--p:#b693f0;--pl:#9b72e0;--pp:#33244d;--bd:#3f2f5c;--er:#ffb3c4;--erb:#4a1d2a;--ok:#a8e6bf;--okb:#1d3d2a;--bt:#1a1226}}
:root[data-theme="dark"]{--bg:#1a1226;--card:#261b38;--tx:#f1eaff;--mu:#b9a6d9;--p:#b693f0;--pl:#9b72e0;--pp:#33244d;--bd:#3f2f5c;--er:#ffb3c4;--erb:#4a1d2a;--ok:#a8e6bf;--okb:#1d3d2a;--bt:#1a1226}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 64px)}
body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5;background-color:var(--bg)}
body.lock{overflow:hidden}
.w{max-width:1040px;margin:0 auto;padding:0 18px}
header{position:sticky;top:0;z-index:20;background:var(--card);border-bottom:1px solid var(--bd)}
header .w{display:flex;align-items:center;justify-content:space-between;height:58px;gap:10px}
.logo{font-weight:800;color:var(--p);text-decoration:none;font-size:17px}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav a{color:var(--tx);text-decoration:none;font-weight:600;font-size:14px;padding:8px 10px;border-radius:10px}
nav a:hover{background:var(--pp)}
.hero{background:var(--pp);padding:44px 0 36px;text-align:center}
